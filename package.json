{
  "name": "pi-safe-rm",
  "version": "0.1.0",
  "description": "Pi extension that rewrites Bash tool `rm` to `gio trash` (system recycle bin) — prevent accidental permanent deletion by coding agents.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ./src/rewrite.test.ts && bun ./src/coexistence.test.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "safe-rm",
    "gio-trash",
    "recycle-bin",
    "safety"
  ],
  "author": "wings1848",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wings1848/pi-safe-rm.git"
  },
  "bugs": {
    "url": "https://github.com/wings1848/pi-safe-rm/issues"
  },
  "homepage": "https://github.com/wings1848/pi-safe-rm#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  }
}
